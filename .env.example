# Use Clerk development keys locally, live keys on the production host.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Use the production Convex URL on the production host.
NEXT_PUBLIC_CONVEX_URL=
# Used by Convex CLI; configure the appropriate deployment locally/with your host.
CONVEX_DEPLOYMENT=
# Set this in the Convex deployment environment as well as locally.
# Create a Clerk JWT template named "convex", audience "convex", including the email claim.
CLERK_JWT_ISSUER_DOMAIN=

GEMINI_API_KEY=
# Optional: override the model with one supported by your Google AI account.
GEMINI_MODEL=
ARCJET_KEY=

# Server-only Google Places key; enable Places API (New).
GOOGLE_PLACE_API_KEY=
# Public Mapbox token. Restrict it to your app's permitted domains.
NEXT_PUBLIC_MAPBOX_API_KEY=
# Weather is optional; leave empty to hide the weather section.
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# HTTPS endpoint that accepts JSON { name, email, message } and delivers support requests.
# A 2xx response is treated as successful delivery.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
